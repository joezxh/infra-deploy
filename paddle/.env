# ===== 复制为 .env 后再启动：cp .env.example .env （Windows: Copy-Item） =====

# ---------- 对外鉴权 ----------
# 调用方必须在请求头带上 X-API-Key，否则 Nginx 返回 401
API_KEY=KdJAG6crwuFg4PQfTMsV3UjOWIbLh210C8vXzmaE

# ---------- 端口 ----------
# 容器只绑 127.0.0.1；Nginx 是唯一对外入口
NGINX_HTTP_PORT=80
OCRV6_PORT=8011
VL_PORT=8012

# ---------- GPU ----------
# nvidia-smi 中的显卡序号；本机 RTX 5070 Ti 为 0
CUDA_DEVICE=0
# vllm 共享内存上限（笔记本内存有限，默认 8g；服务器可上调到 32g/64g）
SHM_SIZE=8g
VLM_BACKEND=vllm

# ---------- PP-OCRv6 ----------
# paddlepaddle 3.3.0 CPU 上 PP-OCRv6 det 模型走 oneDNN(PIR) 会崩，保持 false
OCR_ENABLE_MKLDNN=false
OCR_CPU_THREADS=10

# ---------- 镜像（一般无需改动） ----------
OCRV6_IMAGE=pp-ocrv6:1.0
# RTX 5070 Ti 属 Blackwell(sm_120)，必须用 sm120 标签；其它卡改用 latest-nvidia-gpu-offline
VLM_SERVER_IMAGE=ccr-2vdh3abv-pub.cnc.bj.baidubce.com/paddlepaddle/paddleocr-genai-vllm-server:latest-nvidia-gpu-sm120-offline
VL_API_IMAGE=ccr-2vdh3abv-pub.cnc.bj.baidubce.com/paddlepaddle/paddleocr-vl:latest-nvidia-gpu-sm120-offline
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
