# ===== 复制为 .env 后再启动：Copy-Item .env.example .env =====

# ---------- 对外鉴权 ----------
# 调用方必须在请求头带上 X-API-Key，否则 Nginx 返回 401
API_KEY=change-me-please-use-a-long-random-string

# ---------- 端口 ----------
# OCR 容器只绑 127.0.0.1；Nginx 是唯一对外入口
NGINX_HTTP_PORT=80
OCRV6_PORT=8011

# ---------- PP-OCRv6 ----------
# paddlepaddle 3.3.0 CPU 上 PP-OCRv6 det 模型走 oneDNN(PIR) 会崩，保持 false
OCR_ENABLE_MKLDNN=false
OCR_CPU_THREADS=10

# ---------- 镜像（一般无需改动） ----------
OCRV6_IMAGE=pp-ocrv6:1.0
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
