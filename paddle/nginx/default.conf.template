# Nginx 反代 + API Key 鉴权
# 官方 nginx 镜像启动时会把本文件 envsubst 后写入 /etc/nginx/conf.d/default.conf，
# 其中 ${API_KEY} / ${OCRV6_UPSTREAM} 来自容器环境变量（见 docker-compose.yml）。
# 注意：只有 ${VAR} 形式会被替换，$host、$http_x_api_key 等 nginx 变量保持原样。

server {
    listen 80;
    server_name _;

    default_type application/json;

    client_max_body_size 20m;
    proxy_connect_timeout 60s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    proxy_buffering off;

    # 免鉴权存活探针
    location = /nginx-health {
        return 200 '{"status":"ok","service":"paddle-nginx"}';
    }

    # ---------- PP-OCRv6 文本识别 ----------
    # 外部: /ocr/v6/ocr  ->  容器: /ocr
    location /ocr/v6/ {
        if ($http_x_api_key != "${API_KEY}") {
            return 401 '{"error":"unauthorized","message":"missing or invalid X-API-Key"}';
        }
        proxy_pass ${OCRV6_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 404 '{"error":"not found","routes":["/ocr/v6/ocr","/ocr/v6/health"]}';
    }
}
