# ============================================================
# 矛盾纠纷调解平台 - 应用环境配置
# 
# 使用说明:
# 1. 复制此文件为 .env
# 2. 根据选择的版本修改配置
# 3. 基础设施配置需与 infra/versions 中对应版本一致
# ============================================================

# ============================================================
# 应用模式配置
# ============================================================
# single: 单机版
# ha: 高可用版
APP_MODE=single

# ============================================================
# 基础设施版本
# mysql-neo4j: MySQL + Neo4j 版本
# mysql-nebula: MySQL + NebulaGraph 版本
# pg-neo4j: PostgreSQL + Neo4j 版本
# pg-nebula: PostgreSQL + NebulaGraph 版本
# ============================================================
INFRA_VERSION=mysql-neo4j

# ============================================================
# Docker 镜像仓库 (可选，留空表示使用本地构建)
# ============================================================
REGISTRY=

# ============================================================
# Nacos 配置
# ============================================================
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ============================================================
# MySQL 数据库配置 (mysql 版本使用)
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mediation_db
DB_USERNAME=root
DB_PASSWORD=mediation123

# MySQL 高可用连接 (HA 版本使用 HAProxy)
DB_HA_HOST=127.0.0.1
DB_HA_PORT=33060

# ============================================================
# PostgreSQL 配置 (pg 版本使用)
# ============================================================
PG_HOST=127.0.0.1
PG_PORT=5432
PG_NAME=mediation_db
PG_USERNAME=mediation
PG_PASSWORD=mediation123

# PostgreSQL 高可用连接 (HA 版本使用 PgBouncer)
PG_HA_HOST=127.0.0.1
PG_HA_PORT=5435

# ============================================================
# Redis 配置
# ============================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis Sentinel 配置 (HA 版本)
REDIS_SENTINEL_PORT=26379

# ============================================================
# Neo4j 配置
# ============================================================
NEO4J_HOST=127.0.0.1
NEO4J_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=mediation123

# Neo4j HAProxy (HA 版本)
NEO4J_HA_BOLT_PORT=7689
NEO4J_HA_HTTP_PORT=7476

# ============================================================
# NebulaGraph 配置
# ============================================================
NEBULA_GRAPH_HOST=127.0.0.1
NEBULA_GRAPH_PORT=9669
NEBULA_META_HOST=127.0.0.1
NEBULA_META_PORT=9559

# ============================================================
# RocketMQ 配置
# ============================================================
ROCKETMQ_NAMESRV_ADDR=127.0.0.1:9876
ROCKETMQ_USERNAME=rocketmq
ROCKETMQ_PASSWORD=123456

# ============================================================
# MinIO 配置
# ============================================================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=mediation
MINIO_SECRET_KEY=mediation123456
MINIO_BUCKET=mediation-files

# ============================================================
# JWT 安全配置
# ============================================================
JWT_SECRET=tianque-mediation-platform-jwt-secret-key-2026-at-least-256-bits-long
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ============================================================
# 应用服务端口
# ============================================================
GATEWAY_PORT=8080
UAA_PORT=8081
SYSTEM_PORT=8082
CASE_PORT=8084
MEDIATION_PORT=8085
AI_PORT=8086
AUXILIARY_PORT=8089
VIDEO_PORT=8090
HARNESS_PORT=8091
DISPATCH_PORT=8093
CONTENT_PORT=8094
WEB_PORT=80

# ============================================================
# 服务实例数 (HA 版本使用)
# ============================================================
GATEWAY_REPLICAS=1
UAA_REPLICAS=1
SYSTEM_REPLICAS=1
CASE_REPLICAS=1
MEDIATION_REPLICAS=1
AI_REPLICAS=1
AUXILIARY_REPLICAS=1
VIDEO_REPLICAS=1
HARNESS_REPLICAS=1
DISPATCH_REPLICAS=1
CONTENT_REPLICAS=1

# ============================================================
# JVM 配置 (Java 服务)
# ============================================================
JAVA_XMS=512m
JAVA_XMX=1024m
JAVA_XMN=256m

# ============================================================
# 日志级别
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# API 加密配置
# ============================================================
API_ENCRYPT_ENABLE=true
API_ENCRYPT_ALGORITHM=AES
API_REQUEST_KEY=52549111389893486934626385991395
API_RESPONSE_KEY=96103715984234343991809655248883
