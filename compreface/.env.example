# ===== CompreFace 部署件环境变量样例 =====
# 复制为 .env 后再启动：Copy-Item .env.example .env
# deploy.ps1 会在首次运行时自动生成 .env 并填充随机 API_KEY；密钥禁止提交入仓。

# ---------- CompreFace 版本与官方编排来源 ----------
COMPREFACE_VERSION=1.2.0
COMPREFACE_OFFICIAL_COMPOSE_URL=https://raw.githubusercontent.com/exadel-inc/CompreFace/1.2.0/docker-compose.yml

# ---------- 镜像 ----------
# 自定义构建的 core 镜像（含 YuNet 检测 + SFace 识别 插件，详见 build/core-build/）。
# 用 scripts/build-core.ps1 或：
#   docker build -f build/core-build/Dockerfile -t compreface-core-yunet-sface:1.2.0 build/core-build/
COMPREFACE_CORE_IMAGE=compreface-core-yunet-sface:1.2.0
COMPREFACE_ADMIN_IMAGE=exadel/compreface-admin:1.2.0
COMPREFACE_API_IMAGE=exadel/compreface-api:1.2.0
# fe：默认官方镜像；如需启用「UI 美化 + 中英双语」改造版，指向 compreface-fe-cn:1.2.0
# （构建方式见 build/fe-image/Dockerfile 注释：ui 源码 npm run build:prod 后派生构建）
COMPREFACE_FE_IMAGE=exadel/compreface-fe:1.2.0
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:15-alpine
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# ---------- 端口（避开 OCR 8011 / SER 8020,8021 / paddle-nginx 8080 / 80） ----------
COMPREFACE_NGINX_PORT=8050
COMPREFACE_UI_PORT=8051
# Web 控制台绑定地址：默认 127.0.0.1（仅服务器本机/SSH 隧道可达）。
# 设为 0.0.0.0 则内网任意机器可访问 :8051 —— 管理端无外层 key 保护，须配合 ufw 白名单或可信内网。
COMPREFACE_UI_BIND=127.0.0.1
COMPREFACE_UPSTREAM=http://compreface-fe:80

# ---------- 外层鉴权（业务调用方只持有这一个 key） ----------
# deploy.ps1 自动生成 40 位随机值；也可手工填写长随机串
API_KEY=

# ---------- CompreFace 自身服务 key ----------
# 首次部署后由运维访问 http://127.0.0.1:8051/login 创建
# Face Verification 与 Face Detection 两种类型的 Application / Service，
# 分别复制其生成的 x-api-key 填入下方两项（key 与服务类型绑定，不可混用）。
# 该值由 nginx 通过 proxy_set_header 注入，业务侧不感知。
COMPREFACE_API_KEY=
COMPREFACE_DET_KEY=

# ---------- 数据库：复用宿主已运行的 PostgreSQL ----------
# 经 Docker 网关 host.docker.internal:5432 访问；表结构由 admin/api 的 liquibase 自动建。
# 注意：compose 用 POSTGRES_HOST/PG_DB 拼 POSTGRES_URL 注入（Spring 只认 POSTGRES_URL）；
# 且 PG 不会自动创建数据库，首次部署前需手工确保库存在：
#   docker run --rm -e PGPASSWORD=postgres postgres:15-alpine \
#     psql -h host.docker.internal -U postgres -tc "SELECT 1 FROM pg_database WHERE datname='compreface'"
#   （不存在则）createdb -h host.docker.internal -U postgres compreface
POSTGRES_HOST=host.docker.internal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_DB=compreface
SPRING_PROFILE=dev
ENABLE_EMAIL=false

# ---------- 检测质量参数（口径与阈值须由 G1/G2 本地标定后回写） ----------
FACE_DET_SIZE=640
FACE_MIN_DET_SCORE=0.5
FACE_DETECTION_PLUGIN=yunet.FaceDetector@yunet_2023mar
CALCULATION_PLUGIN=sface.Calculator@sface_2021dec
# 仅检测 + 1:1 识别；必须留空（不能写成 EXTRA_PLUGINS=""，引号会被当字面字符传进容器）
EXTRA_PLUGINS=

# ---------- 上线门禁（恒为 false，禁止改动） ----------
# G0 视频轨可达 / G1 检测可用率 / G2 similarity 阈值标定 / G3 许可与合规。
# 四道门禁留档齐备并人工确认前，MEETING_FACE_POC_PASSED 必须为 false；
# 选定可商用开源权重只解决 G3 的「模型权重授权」子项，不构成置位依据。
MEETING_FACE_POC_PASSED=false

# ---------- 可商用开源权重（YuNet + SFace，OpenCV Zoo / Apache-2.0） ----------
# 权重文件由 download-weights.ps1 经 VPN 代理拉取，放入 ./models
# （compose 以只读方式挂到 /opt/face-weights），本仓库不含权重。
# SHA256 为实拉取后计算值，verify.ps1 第 0 段做离线比对。
FACE_DET_MODEL=face_detection_yunet_2023mar.onnx
FACE_REC_MODEL=face_recognition_sface_2021dec.onnx
FACE_DET_WEIGHTS_URL=https://github.com/opencv/opencv_zoo/tree/master/models/face_detection_yunet
FACE_REC_WEIGHTS_URL=https://github.com/opencv/opencv_zoo/tree/master/models/face_recognition_sface
FACE_DET_SHA256=8F2383E4DD3CFBB4553EA8718107FC0423210DC964F9F4280604804ED2552FA4
FACE_REC_SHA256=0BA9FBFA01B5270C96627C4EF784DA859931E02F04419C829E83484087C34E79
FACE_WEIGHTS_DIR=./models
