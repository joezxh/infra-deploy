# ============================================================
# 矛盾调解平台 - 环境变量配置文件
# ============================================================
# 使用方法:
#   1. 复制此文件为 .env:  cp .env.sample .env
#   2. 修改 .env 中的配置值
#   3. 启动服务: docker compose up -d
# ============================================================

# ============================================================
# 数据库类型选择 (二选一)
# ============================================================
# 可选值: mysql 或 postgres
DB_TYPE=mysql

# ============================================================
# 图数据库类型选择 (二选一)
# ============================================================
# 可选值: neo4j 或 nebula
GRAPH_DB_TYPE=neo4j

# ============================================================
# MySQL 配置
# ============================================================
MYSQL_ROOT_PASSWORD=mediation123
MYSQL_USER=mediation
MYSQL_PASSWORD=mediation123
MYSQL_PORT=3306

# ============================================================
# PostgreSQL 配置
# ============================================================
PG_USER=mediation
PG_PASSWORD=mediation123
PG_PORT=5432

# ============================================================
# Redis 配置
# ============================================================
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb
# Redis 密码 (HA 模式需要)
REDIS_PASSWORD=redis123

# ============================================================
# Nacos 配置
# ============================================================
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
# 是否启用认证
NACOS_AUTH_ENABLE=true
# 认证令牌 (Base64 编码, 默认值对应明文: Nacos!@#$%^&*()::;?>)
NACOS_AUTH_TOKEN=TmFjb3MhQCMkJV4mKigpOjo7Pj8=
# 令牌过期时间 (秒), 默认 5 小时
NACOS_AUTH_TOKEN_EXPIRE_SECONDS=18000
# 服务身份标识
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=nacos
# 是否启用命名空间迁移 (新部署建议关闭)
NACOS_CONFIG_NAMESPACE_MIGRATE_ENABLE=false
# JVM 内存配置
NACOS_JVM_XMS=512m
NACOS_JVM_XMX=1024m

# ============================================================
# Neo4j 配置
# ============================================================
NEO4J_USER=neo4j
NEO4J_PASSWORD=mediation123
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
# 内存配置
NEO4J_HEAP_SIZE=512m
NEO4J_HEAP_MAX_SIZE=2g
NEO4J_PAGECACHE_SIZE=1g

# ============================================================
# NebulaGraph 配置
# ============================================================
NEBULA_METAD_PORT=9559
NEBULA_STORAGED_PORT=9779
NEBULA_GRAPH_PORT=9669

# ============================================================
# MinIO 配置
# ============================================================
MINIO_USER=mediation
MINIO_PASSWORD=mediation123456
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================================
# Nginx 配置
# ============================================================
NGINX_HTTP_PORT=80

# ============================================================
# HA 模式专用配置
# ============================================================
# MySQL HA 端口
MYSQL_PORT_2=3307
MYSQL_PORT_3=3308

# PostgreSQL HA 端口
PG_PORT_2=5433
PG_PORT_3=5434

# Nacos HA 端口
NACOS_PORT_2=8858
NACOS_PORT_3=8868
NACOS_GRPC_PORT_2=9868
NACOS_GRPC_PORT_3=9878

# ============================================================
# 通用配置
# ============================================================
# 时区
TZ=Asia/Shanghai
