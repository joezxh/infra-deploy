# 端口映射 - Docker Desktop 占用了部分默认端口，使用替代端口
MYSQL_PORT=3308
REDIS_PORT=6380
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NEO4J_BOLT_PORT=7689
NEO4J_HTTP_PORT=7476
MINIO_API_PORT=9004
MINIO_CONSOLE_PORT=9001
NGINX_HTTP_PORT=8081

# 数据库配置
MYSQL_ROOT_PASSWORD=mediation123
MYSQL_USER=mediation
MYSQL_PASSWORD=mediation123

# Redis 配置
REDIS_MAXMEMORY=512mb

# Nacos 配置
NACOS_AUTH_ENABLE=false
NACOS_JVM_XMS=512m
NACOS_JVM_XMX=1024m

# Neo4j 配置
NEO4J_USER=neo4j
NEO4J_PASSWORD=mediation123
NEO4J_HEAP_SIZE=512m
NEO4J_HEAP_MAX_SIZE=2g
NEO4J_PAGECACHE_SIZE=1g

# MinIO 配置
MINIO_USER=mediation
MINIO_PASSWORD=mediation123456
