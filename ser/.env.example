# ===== 复制为 .env 后再启动：Copy-Item .env.example .env =====
# 本文件不含任何真实密钥；deploy.ps1 首次运行会生成 .env 并替换 API_KEY / SER_API_KEY

# ---------- 对外鉴权（nginx 与调用方必须是同一个值） ----------
API_KEY=change-me-please-use-a-long-random-string
SER_API_KEY=change-me-please-use-a-long-random-string

# ---------- 端口（推理容器只绑 127.0.0.1） ----------
SER_NGINX_PORT=8020
SER_PORT=8021

# ---------- 模型与算力 ----------
SER_MODEL_ID=iic/emotion2vec_plus_large
# cpu = 分支 B（默认）。改 cuda:0 即分支 A，但必须先按 spec §8.4 量过延迟，
# 且注意 mediation-deploy/paddle 记录的 CUDA 12.8 与 torch cu130 冲突教训。
SER_DEVICE=cpu
SER_MAX_INFLIGHT=2
SER_TORCH_THREADS=8
SER_MEM_LIMIT=6g

# ---------- 镜像 ----------
SER_IMAGE=emotion2vec:1.0
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# ---------- ai-server / worker 侧（与上方保持一致） ----------
# base-url 必须配到 nginx 的 /ser 前缀为止；worker 与 Java 再各拼契约里的后半段
MEETING_SER_ENABLED=false
MEETING_SER_POC_PASSED=false
SER_PROVIDER=none
SER_GATEWAY_BASE_URL=http://127.0.0.1:8020/ser
SER_BASE_URL=http://127.0.0.1:8020/ser
SER_TIMEOUT_MS=1500
