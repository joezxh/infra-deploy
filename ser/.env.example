# 复制为 .env 后填写；本文件不含任何真实密钥
SER_CORE_IMAGE=emotion2vec-ser:local
SER_PUBLIC_PORT=8020
SER_API_KEY=CHANGE_ME_RANDOM_32_BYTES

# ai-server / worker 侧（与之保持一致）
MEETING_SER_ENABLED=false
SER_PROVIDER=none
SER_BASE_URL=http://127.0.0.1:8020
SER_API_KEY=CHANGE_ME_RANDOM_32_BYTES
SER_TIMEOUT_MS=1500

# PoC 门禁（U1-U5 未回写 README 前不得置 true）
MEETING_SER_POC_PASSED=false
