# =============================================================
# LiveKit 部署变量 —— deploy 脚本渲染 livekit.yaml.template，compose 读同一份 .env
#   Linux : cp .env.example .env
#   Windows: Copy-Item .env.example .env
# =============================================================

# ---- 镜像（默认与本机已部署的 mwb-livekit 一致，禁止 latest）----
# 大陆网络备选（本机已预拉）：docker.m.daocloud.io/livekit/livekit-server:v1.13.11
LIVEKIT_IMAGE=crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com/llm-basic/base/livekit-server:v1.13.11

# ---- 通告给客户端的媒体 IP（跨机部署必改）----
# 127.0.0.1 仅适合「浏览器与 Docker 在同一台机器」的本机冒烟。
# 部署到服务器（如 192.168.110.169）时必须填该机对客户端可达的 IP，
# 否则 server 通告 bridge 内网 172.x，客户端会「连上信令但黑屏无声」。
LIVEKIT_NODE_IP=127.0.0.1

# ---- access token 密钥对（必须与 ai-server / livekit-worker 完全一致）----
# 生产先执行： .\deploy.ps1 -Action genkeys   或   ./deploy.sh genkeys
# 把输出填到下面，并同步 ai-server 的 LIVEKIT_API_KEY / LIVEKIT_API_SECRET；
# devkey/secret 是本机已部署实例与 application.yaml 的默认值，仅供冒烟。
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- Redis 模式 ----
# internal = 用本 compose 自带的 redis 服务（默认，同网络服务名 redis:6379）
# external = 复用已有 Redis（脚本不启动内置 redis，地址取下面两项）
REDIS_MODE=internal
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7.4-alpine
LIVEKIT_REDIS_ADDRESS=redis:6379
LIVEKIT_REDIS_PASSWORD=mediation_livekit_redis
# 复用本机已有 redis 容器（infra_net，宿主 6379，--requirepass）示例：
# REDIS_MODE=external
# LIVEKIT_REDIS_ADDRESS=host.docker.internal:6379
# LIVEKIT_REDIS_PASSWORD=<该 redis 的 requirepass>
# 注意：Docker Desktop 自带 host.docker.internal；Linux 已由 compose 的
#       extra_hosts: host.docker.internal:host-gateway 兜底。

# ---- 容器名（与本机 mwb-livekit 区分；端口仍是 7880/7881/7882，同一台机器只能起一个）----
LIVEKIT_CONTAINER_NAME=mediation-livekit
REDIS_CONTAINER_NAME=mediation-livekit-redis

# ---- ai-server 对接备忘（实际写入后端 .env / Nacos，不是本文件变量）----
# LIVEKIT_SERVER_URL=ws://<客户端可达 host>:7880     # 下发给浏览器
# LIVEKIT_API_URL=http://<服务端可达 host>:7880      # 服务端探活
# LIVEKIT_API_KEY=<与上面一致>
# LIVEKIT_API_SECRET=<与上面一致>
